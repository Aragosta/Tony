{
  "prompt": "Add a --shout flag that uppercases the greeting. Update the README usage section and add a test for it.",
  "check": [
    {
      "name": "README documents --shout",
      "run": "grep -q -- \"--shout\" README.md"
    },
    {
      "name": "test covers shout",
      "run": "grep -q shout test/cli.test.ts"
    },
    {
      "name": "tests pass",
      "run": "bun test"
    },
    {
      "name": "--shout works",
      "run": "bun -e 'import {greet} from \"./src/cli.ts\"; if (greet([\"--name\",\"ada\",\"--shout\"]) !== \"HELLO, ADA!\") process.exit(1)'"
    }
  ]
}
